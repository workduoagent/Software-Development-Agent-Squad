{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力。逐项按实际用到的插件裁剪，未使用的权限必须删掉。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:default",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default",
    "notification:default",
    "fs:default",
    "sql:default",
    "store:default"
  ]
}
