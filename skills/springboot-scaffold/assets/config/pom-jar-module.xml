<?xml version="1.0" encoding="UTF-8"?>
<!--
  公共 jar 模块 pom（app-core-common / app-core-config / app-core-web 这一类）。
  spring-boot-maven-plugin 会把没有主类的模块也 repackage 成可执行 jar，
  依赖方按普通 jar 解析时报"没有主清单属性"，因此公共 jar 模块必须显式 skip repackage。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>app-core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>app-core-common</artifactId>
    <packaging>jar</packaging>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
