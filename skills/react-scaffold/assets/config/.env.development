# 开发环境配置（git 已跟踪，可提交）
# 注意：VITE_ 前缀变量会被打进产物，禁止放置任何密钥

# 应用标题（浏览器标签、缺省品牌名）
VITE_APP_TITLE=My App

# 品牌名（顶栏 / 侧栏 Logo 文字）
VITE_APP_BRAND=MyApp

# 接口统一前缀，配合 vite.config.ts 的 server.proxy 使用
VITE_API_BASE_URL=/api

# 后端服务真实地址，只有 dev 代理读取它；后端端口确定后改这里
VITE_BACKEND_ORIGIN=http://localhost:8080

# 是否启用本地 mock：true 时命中 src/api/mock 规则的接口不发网络请求
# 后端就绪后改为 false，业务代码无需改动
VITE_USE_MOCK=true

# 路由模式：hash | history
VITE_ROUTER_MODE=history
